{
	"name": "@jonatsu/pi-verdict",
	"version": "0.16.0-fork.6",
	"description": "A minimal permission gate for Pi in the style of Claude Code's auto mode (fork of @frapetti-dev/pi-verdict)",
	"author": "jonatsu (fork of frapetti-dev, https://github.com/frapetti-dev)",
	"type": "module",
	"main": "extensions/pi-verdict.ts",
	"files": [
		"extensions/pi-verdict.ts",
		"extensions/jev-adapter.ts",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"extension",
		"pi-coding-agent",
		"auto-mode",
		"automode",
		"permissions",
		"security",
		"tool-call",
		"classifier",
		"ai-agent",
		"jev",
		"typesafe",
		"system-one",
		"decisions",
		"openrouter"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonatsu/pi-verdict.git"
	},
	"homepage": "https://github.com/jonatsu/pi-verdict#readme",
	"bugs": "https://github.com/jonatsu/pi-verdict/issues",
	"license": "MIT",
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "bun test",
		"probe": "bun run probe/probe.ts",
		"coverage": "bun run tools/coverage.ts",
		"provenance": "bun run tools/provenance.ts",
		"release-check": "bun run tools/release-check.ts",
		"lint": "mise exec -- biome lint .",
		"format": "mise exec -- biome format --write ."
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=0.84.0",
		"@earendil-works/pi-coding-agent": ">=0.84.0",
		"@earendil-works/pi-tui": ">=0.84.0"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.84.3",
		"@earendil-works/pi-coding-agent": "0.84.3",
		"@earendil-works/pi-tui": "0.84.3",
		"@types/node": "^26.3.0",
		"typescript": "^7.0.2"
	}
}
